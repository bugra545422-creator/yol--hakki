rules_version = '2';
// EHLİYET BENDE — eğitmen / işletme başvuruları, roller ve paylaşılan sorular
service cloud.firestore {
  match /databases/{database}/documents {

    function girisli() { return request.auth != null; }
    function yonetici() {
      return girisli() && request.auth.token.email_verified == true &&
        request.auth.token.email in ['bestudio5454@gmail.com', 'bugra545422@gmail.com'];
    }
    function rolVar() { return girisli() && exists(/databases/$(database)/documents/roller/$(request.auth.uid)); }

    // Başvurular: herkes yalnızca kendi başvurusunu "bekliyor" olarak oluşturur/günceller, onayı sadece yönetici verir
    match /basvurular/{uid} {
      allow read: if yonetici() || (girisli() && request.auth.uid == uid);
      allow create, update: if yonetici() || (girisli() && request.auth.uid == uid
        && request.resource.data.durum == 'bekliyor'
        && request.resource.data.tur in ['egitmen', 'isletme']
        && request.resource.data.eposta == request.auth.token.email
        && request.resource.data.size() < 20);
      allow delete: if yonetici();
    }

    // Roller: onaylanan eğitmen / işletme hesapları (yalnızca yönetici yazar)
    match /roller/{uid} {
      allow read: if yonetici() || (girisli() && request.auth.uid == uid);
      allow write: if yonetici();
    }

    // Eğitmen / kurs profilleri: şehir listesinde herkes okur; yalnızca onaylı hesap kendi profilini, yönetici hepsini yazar
    match /egitmenler/{uid} {
      allow read: if true;
      allow create, update: if yonetici() || (rolVar() && request.auth.uid == uid
        && request.resource.data.sehir is string && request.resource.data.size() < 16
        && request.resource.data.get('tanitim', '').size() <= 300
        && request.resource.data.get('siniflar', []).size() <= 10);
      allow delete: if yonetici() || (girisli() && request.auth.uid == uid);
    }

    // Paylaşım akışı: herkes okur; onaylı eğitmen/kurs ve yönetici paylaşır; öne çıkarma ve düzenleme yalnızca yönetici
    match /paylasimlar/{id} {
      allow read: if true;
      allow create: if (rolVar() || yonetici()) && request.resource.data.uid == request.auth.uid
        && request.resource.data.sehir is string && request.resource.data.size() < 16
        && request.resource.data.get('metin', '').size() <= 600
        && request.resource.data.get('foto', '').size() < 350000
        && request.resource.data.get('oneCikan', false) == false
        && (!('foto' in request.resource.data) || request.resource.data.izin == true);
      allow update: if yonetici();
      allow delete: if yonetici() || (girisli() && resource.data.uid == request.auth.uid);
      match /begeniler/{uid} {
        allow read: if true;
        allow create, update: if girisli() && request.auth.uid == uid && request.resource.data.size() < 3;
        allow delete: if girisli() && request.auth.uid == uid;
      }
    }

    // Şikayetler: herkes bildirim oluşturabilir; yalnızca yönetici okur ve kapatır
    match /sikayetler/{id} {
      allow create: if request.resource.data.keys().hasOnly(['pid', 'neden', 'aciklama', 'uid', 'tarih', 'durum'])
        && request.resource.data.pid is string && request.resource.data.neden is string && request.resource.data.neden.size() < 80
        && request.resource.data.get('aciklama', '').size() <= 300 && request.resource.data.durum == 'acik';
      allow read, update, delete: if yonetici();
    }

    // Kullanıcı verileri: sınav geçmişi, istatistikler, Premium ve güzergah rekoru (telefon ↔ site eşitleme). Yalnızca kendisi okur/yazar.
    match /kullanicilar/{uid} {
      allow read, write: if girisli() && request.auth.uid == uid;
    }

    // Sorular: herkes okur; onaylı eğitmen / işletme ve yönetici ekler; kendi sorusunu siler
    match /sorular/{id} {
      allow read: if true;
      allow create: if (rolVar() || yonetici())
        && request.resource.data.ekleyenUid == request.auth.uid
        && request.resource.data.kat is string && request.resource.data.metin is string
        && request.resource.data.dogru is string && request.resource.data.yanlislar is list
        && request.resource.data.yanlislar.size() == 3 && request.resource.data.metin.size() < 1000;
      allow update, delete: if yonetici() || (rolVar() && resource.data.ekleyenUid == request.auth.uid);
    }

    // Haftalık sıralama: herkes okur; giriş yapmış kullanıcı yalnızca kendi satırını yazar/siler
    match /siralama/{hafta}/{liste}/{uid} {
      allow read: if true;
      allow create, update: if girisli() && request.auth.uid == uid
        && request.resource.data.puan is int && request.resource.data.puan >= 0 && request.resource.data.puan <= 3000
        && request.resource.data.ad is string && request.resource.data.ad.size() <= 40
        && request.resource.data.size() <= 6;
      allow delete: if girisli() && request.auth.uid == uid;
    }

    // Düello: giriş yapmış kullanıcılar okur; kurucu oluşturur ve kendi sonucunu, rakip yalnızca bir kez kendi sonucunu yazar
    match /duello/{kod} {
      allow read: if girisli();
      allow create: if girisli() && request.resource.data.kurucu == request.auth.uid
        && request.resource.data.sorular is list && request.resource.data.sorular.size() == 10
        && request.resource.data.r == null && request.resource.data.k == null;
      allow update: if girisli() && (
        (resource.data.kurucu == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['k']))
        || (resource.data.r == null && resource.data.kurucu != request.auth.uid
            && request.resource.data.r.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r'])));
    }
  }
}
